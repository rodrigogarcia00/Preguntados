<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preguntados</title>
    <link rel="stylesheet" href="/public/css/login.css">
</head>
<body>

<main class="auth-container">
    <section class="auth-card">
        <h1>Iniciar sesión</h1>
        <p class="auth-subtitle">Ingresá con tu cuenta para acceder al lobby.</p>

        {{#avisoActivacion}}
                <p class="auth-notification">{{.}}</p>
        {{/avisoActivacion}}

        <form action="/login/validar" method="POST" class="auth-form">
            <div class="form-group">
                <label>Nombre de usuario</label>
                <input type="text" name="username" required>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input type="password" name="password" required>
            </div>

            {{#error}}
                <p class="auth-error">{{.}}</p>
            {{/error}}

            <button type="submit">Iniciar sesión</button>
        </form>

        <p class="auth-link">
            ¿No tenés cuenta?
            <a href="/login/verRegistro">Registrate</a>
        </p>
    </section>
</main>

</body>
</html>