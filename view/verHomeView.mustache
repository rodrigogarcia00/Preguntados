{{>header}}

<main class="container">
    <section class="hero">
        <h2>Demostrá cuánto sabés</h2>
        <p>
            Respondé preguntas de distintas categorías, sumá puntos y competí contra otros jugadores.
        </p>

        <div class="hero-actions">
            <a href="#" class="btn btn-primary">Nueva partida</a>
            <a href="#" class="btn btn-secondary">Ver ranking</a>
        </div>
    </section>

    <section class="history">
        <h2>Historial de partidas</h2>

        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Categoría final</th>
                    <th>Puntaje obtenido</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>30/05/2026</td>
                    <td><span class="category historia">Historia</span></td>
                    <td>8 puntos</td>
                </tr>
                <tr>
                    <td>28/05/2026</td>
                    <td><span class="category deportes">Deportes</span></td>
                    <td>5 puntos</td>
                </tr>
                <tr>
                    <td>25/05/2026</td>
                    <td><span class="category cultura">Cultura</span></td>
                    <td>3 puntos</td>
                </tr>
            </tbody>
        </table>
    </section>
</main>

{{>footer}}